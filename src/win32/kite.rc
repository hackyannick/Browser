#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_KITE ICON "kite.ico"

1 RT_MANIFEST "kite.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "CompanyName", "Kite Project"
      VALUE "FileDescription", "Kite Webbrowser"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "kite"
      VALUE "OriginalFilename", "kite.exe"
      VALUE "ProductName", "Kite Browser"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 290, 196
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Einstellungen"
FONT 8, "MS Shell Dlg"
BEGIN
  GROUPBOX "Allgemein", -1, 7, 4, 276, 74
  LTEXT "Startseite:", -1, 14, 18, 60, 8
  EDITTEXT IDC_SET_HOME, 80, 16, 196, 13, ES_AUTOHSCROLL
  LTEXT "Suchmaschine:", -1, 14, 36, 60, 8
  EDITTEXT IDC_SET_SEARCH, 80, 34, 196, 13, ES_AUTOHSCROLL
  LTEXT "Standard-Zoom (%):", -1, 14, 54, 64, 8
  EDITTEXT IDC_SET_ZOOM, 80, 52, 30, 13, ES_NUMBER
  AUTOCHECKBOX "Bilder laden", IDC_SET_IMAGES, 130, 53, 100, 10
  GROUPBOX "Verbindung", -1, 7, 82, 276, 34
  LTEXT "HTTP-Proxy:", -1, 14, 98, 60, 8
  EDITTEXT IDC_SET_PROXYHOST, 80, 96, 130, 13, ES_AUTOHSCROLL
  LTEXT "Port:", -1, 216, 98, 20, 8
  EDITTEXT IDC_SET_PROXYPORT, 238, 96, 38, 13, ES_NUMBER
  GROUPBOX "Datenschutz", -1, 7, 120, 276, 46
  LTEXT "", IDC_SET_COOKIEINFO, 14, 134, 180, 8
  PUSHBUTTON "Cookies löschen", IDC_SET_CLEARCOOKIES, 14, 146, 80, 14
  DEFPUSHBUTTON "OK", IDOK, 178, 174, 50, 14
  PUSHBUTTON "Abbrechen", IDCANCEL, 233, 174, 50, 14
END
