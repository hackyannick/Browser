#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_KITE ICON "kite.ico"

1 RT_MANIFEST "kite.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "CompanyName", "Kite Project"
      VALUE "FileDescription", "Kite Webbrowser"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "kite"
      VALUE "OriginalFilename", "kite.exe"
      VALUE "ProductName", "Kite Browser"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 290, 252
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Einstellungen"
FONT 8, "MS Shell Dlg"
BEGIN
  GROUPBOX "Allgemein", -1, 7, 4, 276, 74
  LTEXT "Startseite:", -1, 14, 18, 60, 8
  EDITTEXT IDC_SET_HOME, 80, 16, 196, 13, ES_AUTOHSCROLL
  LTEXT "Suchmaschine:", -1, 14, 36, 60, 8
  EDITTEXT IDC_SET_SEARCH, 80, 34, 196, 13, ES_AUTOHSCROLL
  LTEXT "Standard-Zoom (%):", -1, 14, 54, 64, 8
  EDITTEXT IDC_SET_ZOOM, 80, 52, 30, 13, ES_NUMBER
  AUTOCHECKBOX "Bilder laden", IDC_SET_IMAGES, 124, 53, 60, 10
  AUTOCHECKBOX "JavaScript aktivieren", IDC_SET_JS, 190, 53, 88, 10
  GROUPBOX "Verbindung", -1, 7, 82, 276, 34
  LTEXT "HTTP-Proxy:", -1, 14, 98, 60, 8
  EDITTEXT IDC_SET_PROXYHOST, 80, 96, 130, 13, ES_AUTOHSCROLL
  LTEXT "Port:", -1, 216, 98, 20, 8
  EDITTEXT IDC_SET_PROXYPORT, 238, 96, 38, 13, ES_NUMBER
  GROUPBOX "Datenschutz und Inhalte", -1, 7, 120, 276, 104
  AUTOCHECKBOX "Werbung und Tracker blockieren", IDC_SET_ADBLOCK, 14, 133, 130, 10
  AUTOCHECKBOX "Popups blockieren", IDC_SET_POPUPS, 150, 133, 120, 10
  AUTOCHECKBOX "Tabs beim Start wiederherstellen", IDC_SET_RESTORE, 14, 147, 130, 10
  AUTOCHECKBOX "Als Firefox ausgeben", IDC_SET_COMPATUA, 150, 147, 120, 10
  LTEXT "", IDC_SET_COOKIEINFO, 14, 164, 120, 8
  PUSHBUTTON "Cookies löschen", IDC_SET_CLEARCOOKIES, 150, 161, 80, 14
  LTEXT "Festplattencache (MB):", -1, 14, 186, 80, 8
  EDITTEXT IDC_SET_CACHE, 96, 184, 34, 13, ES_NUMBER
  PUSHBUTTON "Cache leeren", IDC_SET_CLEARCACHE, 150, 183, 80, 14
  LTEXT "", IDC_SET_CACHEINFO, 14, 204, 260, 8
  DEFPUSHBUTTON "OK", IDOK, 178, 230, 50, 14
  PUSHBUTTON "Abbrechen", IDCANCEL, 233, 230, 50, 14
END

IDD_PROMPT DIALOGEX 0, 0, 260, 86
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Eingabe"
FONT 8, "MS Shell Dlg"
BEGIN
  LTEXT "", IDC_PROMPT_TEXT, 7, 7, 246, 32
  EDITTEXT IDC_PROMPT_EDIT, 7, 44, 246, 13, ES_AUTOHSCROLL
  DEFPUSHBUTTON "OK", IDOK, 148, 65, 50, 14
  PUSHBUTTON "Abbrechen", IDCANCEL, 203, 65, 50, 14
END
